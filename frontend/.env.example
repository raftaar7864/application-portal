VITE_API_URL=http://localhost:5000/api

# REQUIRED for Google indexing when the frontend is deployed.
# Use the final HTTPS website origin, without a trailing slash.
# VITE_SITE_URL=https://your-real-domain.in

# Optional: Google Search Console HTML tag verification value (content="...").
# VITE_GOOGLE_SITE_VERIFICATION=

# Optional at build time. Endpoint must be reachable without admin login.
# Only published programmes are included. Rebuild after publishing a new programme.
# SEO_SITEMAP_API_URL=https://your-api-domain.in/api

# Footer telephone contacts — shown publicly, so confirm these before launch.
# These project numbers come from the supplied training brochure.
VITE_PROJECT_CONTACT_PHONE_1=7044414004
