PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/jis_recruitment?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-unique-random-secret-32-chars-minimum
OTP_PEPPER=change-me-to-another-long-unique-random-secret
CLIENT_URL=http://localhost:5173

# Required for real email. If SMTP_HOST is unset in development, OTPs print to the API terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Recruitment Portal <no-reply@example.org>

# ADMIN seed credentials (set before running npm run seed):
ADMIN_NAME=Recruitment Administrator
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: organization name printed on acknowledgement/interview/joining PDFs and emails.
RECRUITMENT_ORG_NAME=JIS Group - Narula Educational Trust
# Optional: absolute path to an installed Unicode .ttf font on YOUR server for Bengali script in PDFs.
# On Windows, example: C:\Windows\Fonts\Nirmala.ttf
# PDF_FONT_PATH=

# Optional live XML sitemap endpoint: use your PUBLIC frontend HTTPS URL (not API URL).
# SEO_PUBLIC_SITE_URL=https://your-real-domain.in

# Railway Free/Trial/Hobby: SMTP is blocked; configure an HTTPS email API instead.
# When RESEND_API_KEY is present it takes precedence over SMTP_HOST.
# Verify your sending domain in Resend before using it for candidates.
RESEND_API_KEY=
RESEND_FROM=Recruitment Team <noreply@your-verified-domain.in>
